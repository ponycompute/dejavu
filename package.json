{
  "name": "agent-dejavu",
  "version": "0.1.0",
  "description": "Replay a coding-agent session as a video that looks exactly like the agent's own UI",
  "keywords": [
    "claude-code",
    "codex",
    "grok",
    "coding-agent",
    "terminal",
    "video",
    "replay",
    "cli"
  ],
  "author": "ponycompute",
  "homepage": "https://github.com/ponycompute/dejavu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponycompute/dejavu.git"
  },
  "bugs": {
    "url": "https://github.com/ponycompute/dejavu/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "dejavu": "bin/dejavu.js"
  },
  "files": [
    "bin",
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "sample": "tsx fixtures/make-sample.ts && tsx src/cli.ts fixtures/claude-code-sample.jsonl -o out/sample.mp4",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@napi-rs/canvas": "^1.0.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
